# Copy this file to Backend/.env and replace the placeholder values with your own.
# Never commit Backend/.env — it is ignored by .gitignore.

# MongoDB connection string (MongoDB Atlas or a local MongoDB instance)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# Secret used to sign JWT login tokens — use a long, random string
JWT_SECRET=replace-with-a-long-random-secret

# API key for the NVIDIA AI API (https://build.nvidia.com), used for interview plans and resume generation
NVIDIA_API_KEY=your-nvidia-api-key
